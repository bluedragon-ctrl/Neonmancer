{
  "$schema": "../../schemas/room.schema.json",
  "schemaVersion": 1,
  "id": "scan_lab",
  "name": "Scan Lab",
  "biome": "home_lattice",
  "size": [12, 5, 12],
  "spawn": [1.5, 0, 5.5],
  "exits": [
    { "id": "west", "side": "-x", "at": 5 },
    { "id": "east", "side": "+x", "at": 5 },
    { "id": "south", "side": "+z", "at": 0 },
    { "id": "north", "side": "-z", "at": 4, "width": 1, "hidden": true }
  ],
  "blocks": [
    { "at": [0, 0, 0], "to": [1, 1, 1] },
    { "type": "fence", "at": [5, 0, 0], "to": [5, 2, 4] },
    { "type": "fake", "at": [5, 0, 5], "to": [5, 1, 6] },
