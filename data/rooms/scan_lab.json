    { "id": "screen_scan", "type": "screen", "at": [0, 0, 4], "text": "help_scan", "overrides": { "face": "+x" } },
    { "id": "pillar_lab", "type": "data_pillar", "at": [3, 0, 0] },
    { "id": "crate_1", "type": "crate", "at": [3, 0, 9] },
    { "id": "crate_2", "type": "crate", "at": [7, 1, 9] },
    { "id": "plate_back", "type": "plate_timed", "at": [11, 0, 0] }
  ],
  "pickups": [{ "id": "disk_scan", "type": "disk_scan", "at": [0, 2, 0] }]
}
