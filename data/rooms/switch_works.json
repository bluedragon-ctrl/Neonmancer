    { "id": "bridge_1", "type": "bridge", "at": [5, 0, 8], "switches": ["beacon"] },
    { "id": "bridge_2", "type": "bridge", "at": [5, 0, 9], "switches": ["beacon"] },
    { "id": "lift_plate", "type": "plate", "at": [8, 0, 11] },
    { "id": "crate", "type": "crate", "at": [9, 0, 11] },
    {
      "id": "lift",
      "type": "platform",
      "at": [3, 0, 11],
      "path": { "points": [[3, 2, 11]], "pause": 1 },
      "switches": ["lift_plate"]
    }
  ],
  "pickups": [{ "id": "energy", "type": "refill_energy", "at": [1, 3, 11] }]
}
