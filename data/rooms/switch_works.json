{
  "$schema": "../../schemas/room.schema.json",
  "schemaVersion": 1,
  "id": "switch_works",
  "name": "Switch Works",
  "biome": "home_lattice",
  "size": [12, 5, 12],
  "spawn": [5.5, 0, 1.5],
  "exits": [{ "id": "north", "side": "-z", "at": 5 }],
  "blocks": [
    { "at": [0, 0, 6], "to": [4, 1, 6] },
    { "at": [7, 0, 6], "to": [11, 1, 6] },
    { "at": [0, 0, 10], "to": [2, 2, 11] }
  ],
  "holes": [{ "at": [0, 8], "to": [11, 9] }],
  "objects": [
    { "id": "timer_plate", "type": "plate_timed", "at": [2, 0, 2] },
    { "id": "door_1", "type": "gate", "at": [5, 0, 6], "switches": ["timer_plate"] },
    { "id": "door_2", "type": "gate", "at": [6, 0, 6], "switches": ["timer_plate"] },
    { "id": "door_3", "type": "gate", "at": [5, 1, 6], "switches": ["timer_plate"] },
