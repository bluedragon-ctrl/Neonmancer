{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "defs.schema.json",
  "title": "Type definitions (data/defs.json)",
  "description": "Object types with their defaults. Enemy types and spells join in later phases.",
  "type": "object",
  "required": ["schemaVersion", "objects"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "$ref": "common.schema.json#/$defs/schemaVersion" },
    "objects": {
      "type": "object",
      "propertyNames": { "$ref": "common.schema.json#/$defs/id" },
      "additionalProperties": { "$ref": "#/$defs/objectType" }
    }
  },
  "$defs": {
    "objectType": {
      "type": "object",
      "required": ["kind", "color"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["pushable"], "description": "Which engine behavior the object uses." },
        "color": { "$ref": "common.schema.json#/$defs/color" },
        "edges": {
          "enum": ["solid", "dashed"],
          "default": "solid",
          "description": "Outline style."
        },
        "mark": {
          "enum": ["none", "inset", "cross", "brackets"],
          "default": "none",
          "description": "Pattern drawn on every face."
        },
        "faces": {
          "enum": ["dark", "tinted"],
          "default": "dark",
          "description": "dark: like static blocks; tinted: faces shaded in the object color (top lighter)."
        },
        "tint": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.1,
          "description": "With tinted faces: share of the object color in the top face; the sides get less."
        }
      }
    }
  }
}
